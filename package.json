{
	"name": "weave",
	"type": "module",
	"version": "0.0.1",
	"bin": {
		"weave": "./cli/index.ts"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"cli": "bun cli/index.ts",
		"test": "bun test tests/unit",
		"test:e2e": "playwright test",
		"bench": "bun test ./tests/bench",
		"contract:export": "bun run scripts/contract-export.ts",
		"contract:types": "json2ts -i contract/v1/schema/defs.schema.json -o contract/v1/types.ts --no-additionalProperties --unreachableDefinitions",
		"contract:check": "bun test ./tests/contract",
		"contract:verify": "bun run contract:export && bun run contract:check",
		"lint": "biome check .",
		"lint:md": "markdownlint-cli2",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@astrojs/preact": "^6.0.2",
		"@tailwindcss/vite": "^4.3.3",
		"astro": "^7.1.6",
		"preact": "^10.29.8",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@playwright/test": "^1.62.1",
		"@types/bun": "^1.3.14",
		"@types/node": "^26.1.2",
		"ajv": "^8.20.0",
		"bun-types": "^1.3.14",
		"json-schema-to-typescript": "^16.0.0",
		"markdownlint-cli2": "^0.23.2",
		"typescript": "^7.0.2"
	}
}
