{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://weave.dev/contract/v1/defs.schema.json",
	"title": "WeaveContractV1",
	"description": "Authoritative document, graph, search and CLI envelope definitions for Weave contract v1.",
	"type": "object",
	"additionalProperties": false,
	"$defs": {
		"OkfVersion": {
			"type": "string",
			"enum": [
				"0.2"
			]
		},
		"ConceptStatus": {
			"type": "string",
			"enum": [
				"draft",
				"stable",
				"deprecated"
			]
		},
		"SearchMode": {
			"type": "string",
			"enum": [
				"keyword",
				"fuzzy",
				"hybrid",
				"bm25"
			]
		},
		"SearchField": {
			"type": "string",
			"enum": [
				"title",
				"keywords",
				"description",
				"body"
			]
		},
		"AuditFailOn": {
			"type": "string",
			"enum": [
				"error",
				"warning",
				"none"
			]
		},
		"AuditSeverity": {
			"type": "string",
			"enum": [
				"error",
				"warning",
				"info"
			]
		},
		"AuditFindingCode": {
			"type": "string",
			"enum": [
				"MISSING_FRONTMATTER",
				"MISSING_TYPE",
				"MISSING_KEYWORDS",
				"BROKEN_LINK",
				"BROKEN_RELATED",
				"MISSING_INDEX_TARGET",
				"UNINDEXED_CONCEPT",
				"ORPHAN_CONCEPT",
				"UNSUPPORTED_OKF_VERSION",
				"EMPTY_BUNDLE",
				"DANGLING_EXTERNAL",
				"KEY_UNAVAILABLE"
			]
		},
		"RelateDirection": {
			"type": "string",
			"enum": [
				"out",
				"in",
				"both"
			]
		},
		"PrivacyPolicy": {
			"type": "string",
			"enum": [
				"none",
				"encrypt",
				"tokenize",
				"hash",
				"mixed"
			]
		},
		"PrivacyDirective": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"policy"
			],
			"properties": {
				"policy": {
					"$ref": "#/$defs/PrivacyPolicy"
				},
				"provider": {
					"type": "string"
				},
				"key_id": {
					"type": "string"
				},
				"encoded": {
					"type": "boolean"
				},
				"provider_name": {
					"type": "string"
				},
				"key_version": {
					"type": "integer",
					"minimum": 0
				}
			}
		},
		"PrivacyState": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"policy",
				"redacted",
				"decrypted"
			],
			"properties": {
				"policy": {
					"$ref": "#/$defs/PrivacyPolicy"
				},
				"provider": {
					"type": "string"
				},
				"key_id": {
					"type": "string"
				},
				"redacted": {
					"type": "boolean"
				},
				"decrypted": {
					"type": "boolean"
				}
			}
		},
		"ExplainKeywordMatch": {
			"type": "string",
			"enum": [
				"exact",
				"prefix",
				"none"
			]
		},
		"ErrorCode": {
			"type": "string",
			"enum": [
				"INVALID_REQUEST",
				"INVALID_ROOT",
				"PERMISSION_DENIED",
				"PARSE_ERROR",
				"CONCEPT_NOT_FOUND",
				"PATH_NOT_FOUND",
				"BUNDLE_NOT_INDEXED",
				"EXTENSION_NOT_FOUND",
				"EXTENSION_TIMEOUT",
				"EXTENSION_FAILED",
				"EXTENSION_PROTOCOL",
				"PRIVACY_DIRECTIVE_INVALID",
				"PRIVACY_KEY_UNAVAILABLE",
				"PRIVACY_PROVIDER_UNSUPPORTED",
				"PRIVACY_DECRYPT_FAILED",
				"INTERNAL",
				"CONFIRMATION_REQUIRED"
			]
		},
		"OperationName": {
			"type": "string",
			"enum": [
				"contract",
				"parse",
				"graph",
				"search",
				"list",
				"show",
				"backlinks",
				"path",
				"version",
				"audit",
				"relate",
				"explain",
				"ingest",
				"rebuild",
				"sync",
				"extensions",
				"export"
			]
		},
		"OkfLink": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"raw",
				"target",
				"resolves_in_bundle"
			],
			"properties": {
				"raw": {
					"type": "string"
				},
				"target": {
					"type": "string"
				},
				"resolved": {
					"type": "string"
				},
				"resolves_in_bundle": {
					"type": "boolean"
				}
			}
		},
		"OkfConcept": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"path",
				"frontmatter",
				"type",
				"keywords",
				"body",
				"links"
			],
			"properties": {
				"id": {
					"type": "string"
				},
				"path": {
					"type": "string"
				},
				"frontmatter": {
					"type": "object",
					"additionalProperties": true
				},
				"type": {
					"type": "string"
				},
				"keywords": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					}
				},
				"title": {
					"type": "string"
				},
				"description": {
					"type": "string"
				},
				"tags": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"status": {
					"$ref": "#/$defs/ConceptStatus"
				},
				"body": {
					"type": "string"
				},
				"links": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/OkfLink"
					}
				},
				"privacy": {
					"$ref": "#/$defs/PrivacyDirective"
				}
			}
		},
		"IndexEntry": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"title",
				"target"
			],
			"properties": {
				"title": {
					"type": "string"
				},
				"target": {
					"type": "string"
				},
				"description": {
					"type": "string"
				}
			}
		},
		"ConceptValidation": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"has_frontmatter",
				"has_type",
				"has_keywords",
				"warnings"
			],
			"properties": {
				"id": {
					"type": "string"
				},
				"has_frontmatter": {
					"type": "boolean"
				},
				"has_type": {
					"type": "boolean"
				},
				"has_keywords": {
					"type": "boolean"
				},
				"warnings": {
					"type": "array",
					"items": {
						"type": "string"
					}
				}
			}
		},
		"Validation": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"valid",
				"concepts",
				"warnings"
			],
			"properties": {
				"valid": {
					"type": "boolean"
				},
				"permissive": {
					"type": "boolean"
				},
				"concepts": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/ConceptValidation"
					}
				},
				"warnings": {
					"type": "array",
					"items": {
						"type": "string"
					}
				}
			}
		},
		"Bundle": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"root",
				"concepts",
				"validation"
			],
			"properties": {
				"root": {
					"type": "string"
				},
				"okf_version": {
					"$ref": "#/$defs/OkfVersion"
				},
				"concepts": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/OkfConcept"
					}
				},
				"index": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/IndexEntry"
					}
				},
				"validation": {
					"$ref": "#/$defs/Validation"
				}
			}
		},
		"GraphNode": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"path",
				"type",
				"title",
				"keywords",
				"in_degree",
				"out_degree"
			],
			"properties": {
				"id": {
					"type": "string"
				},
				"path": {
					"type": "string"
				},
				"type": {
					"type": "string"
				},
				"title": {
					"type": "string"
				},
				"keywords": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"status": {
					"$ref": "#/$defs/ConceptStatus"
				},
				"tags": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"in_degree": {
					"type": "integer",
					"minimum": 0
				},
				"out_degree": {
					"type": "integer",
					"minimum": 0
				},
				"source": {
					"type": "string"
				}
			}
		},
		"GraphEdge": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"from",
				"to",
				"source"
			],
			"properties": {
				"from": {
					"type": "string"
				},
				"to": {
					"type": "string"
				},
				"source": {
					"type": "string",
					"enum": [
						"link",
						"related"
					]
				},
				"raw": {
					"type": "string"
				}
			}
		},
		"Graph": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"nodes",
				"edges",
				"dangling"
			],
			"properties": {
				"nodes": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/GraphNode"
					}
				},
				"edges": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/GraphEdge"
					}
				},
				"dangling": {
					"type": "object",
					"additionalProperties": {
						"type": "array",
						"items": {
							"$ref": "#/$defs/OkfLink"
						}
					}
				}
			}
		},
		"KeywordHit": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"title",
				"path",
				"type",
				"keywords",
				"matched_keywords",
				"score"
			],
			"properties": {
				"id": {
					"type": "string"
				},
				"title": {
					"type": "string"
				},
				"path": {
					"type": "string"
				},
				"type": {
					"type": "string"
				},
				"keywords": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"matched_keywords": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"score": {
					"type": "number",
					"minimum": 0,
					"maximum": 1
				},
				"rerank_score": {
					"type": "number",
					"minimum": 0,
					"maximum": 1
				},
				"source": {
					"type": "string"
				}
			}
		},
		"FuzzyHit": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"title",
				"path",
				"type",
				"score",
				"matched_fields"
			],
			"properties": {
				"id": {
					"type": "string"
				},
				"title": {
					"type": "string"
				},
				"path": {
					"type": "string"
				},
				"type": {
					"type": "string"
				},
				"score": {
					"type": "number",
					"minimum": 0,
					"maximum": 1
				},
				"matched_fields": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/SearchField"
					}
				},
				"snippet": {
					"type": "string"
				},
				"rerank_score": {
					"type": "number",
					"minimum": 0,
					"maximum": 1
				},
				"source": {
					"type": "string"
				}
			}
		},
		"HybridHit": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"title",
				"path",
				"type",
				"keyword_score",
				"fuzzy_score",
				"total_score",
				"matched_keywords",
				"matched_fields"
			],
			"properties": {
				"id": {
					"type": "string"
				},
				"title": {
					"type": "string"
				},
				"path": {
					"type": "string"
				},
				"type": {
					"type": "string"
				},
				"keyword_score": {
					"type": "number",
					"minimum": 0,
					"maximum": 1
				},
				"lexical_score": {
					"type": "number",
					"minimum": 0,
					"maximum": 1
				},
				"fuzzy_score": {
					"type": "number",
					"minimum": 0,
					"maximum": 1
				},
				"total_score": {
					"type": "number",
					"minimum": 0,
					"maximum": 1
				},
				"matched_keywords": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"matched_fields": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/SearchField"
					}
				},
				"snippet": {
					"type": "string"
				},
				"rerank_score": {
					"type": "number",
					"minimum": 0,
					"maximum": 1
				},
				"source": {
					"type": "string"
				}
			}
		},
		"LexicalHit": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"title",
				"path",
				"type",
				"raw_score",
				"score"
			],
			"properties": {
				"id": {
					"type": "string"
				},
				"title": {
					"type": "string"
				},
				"path": {
					"type": "string"
				},
				"type": {
					"type": "string"
				},
				"raw_score": {
					"type": "number",
					"minimum": 0
				},
				"score": {
					"type": "number",
					"minimum": 0,
					"maximum": 1
				},
				"rerank_score": {
					"type": "number",
					"minimum": 0,
					"maximum": 1
				},
				"source": {
					"type": "string"
				}
			}
		},
		"SearchResponse": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"query",
				"mode",
				"top_k",
				"keyword",
				"fuzzy",
				"hybrid"
			],
			"properties": {
				"query": {
					"type": "string"
				},
				"mode": {
					"$ref": "#/$defs/SearchMode"
				},
				"top_k": {
					"type": "integer",
					"minimum": 1,
					"maximum": 100
				},
				"keyword": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/KeywordHit"
					}
				},
				"fuzzy": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/FuzzyHit"
					}
				},
				"hybrid": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/HybridHit"
					}
				},
				"lexical": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/LexicalHit"
					}
				}
			}
		},
		"ListResult": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"title",
				"path",
				"type",
				"keywords"
			],
			"properties": {
				"id": {
					"type": "string"
				},
				"title": {
					"type": "string"
				},
				"path": {
					"type": "string"
				},
				"type": {
					"type": "string"
				},
				"keywords": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"status": {
					"$ref": "#/$defs/ConceptStatus"
				},
				"tags": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"source": {
					"type": "string"
				}
			}
		},
		"ListResults": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/ListResult"
			}
		},
		"ShowLink": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"raw",
				"target",
				"resolves_in_bundle"
			],
			"properties": {
				"raw": {
					"type": "string"
				},
				"target": {
					"type": "string"
				},
				"resolves_in_bundle": {
					"type": "boolean"
				}
			}
		},
		"ShowResult": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"path",
				"type",
				"keywords",
				"body",
				"links",
				"backlinks"
			],
			"properties": {
				"id": {
					"type": "string"
				},
				"path": {
					"type": "string"
				},
				"type": {
					"type": "string"
				},
				"keywords": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"title": {
					"type": "string"
				},
				"description": {
					"type": "string"
				},
				"tags": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"status": {
					"$ref": "#/$defs/ConceptStatus"
				},
				"body": {
					"type": "string"
				},
				"links": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/ShowLink"
					}
				},
				"backlinks": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"privacy": {
					"$ref": "#/$defs/PrivacyState"
				},
				"source": {
					"type": "string"
				}
			}
		},
		"Backlink": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"from",
				"title"
			],
			"properties": {
				"from": {
					"type": "string"
				},
				"title": {
					"type": "string"
				}
			}
		},
		"BacklinksResult": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"backlinks"
			],
			"properties": {
				"id": {
					"type": "string"
				},
				"backlinks": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/Backlink"
					}
				}
			}
		},
		"PathResult": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"from",
				"to",
				"path"
			],
			"properties": {
				"from": {
					"type": "string"
				},
				"to": {
					"type": "string"
				},
				"path": {
					"type": [
						"array",
						"null"
					],
					"items": {
						"type": "string"
					}
				},
				"source": {
					"type": "string"
				}
			}
		},
		"AuditFinding": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"code",
				"severity",
				"message"
			],
			"properties": {
				"code": {
					"$ref": "#/$defs/AuditFindingCode"
				},
				"severity": {
					"$ref": "#/$defs/AuditSeverity"
				},
				"concept": {
					"type": "string"
				},
				"source": {
					"type": "string"
				},
				"target": {
					"type": "string"
				},
				"message": {
					"type": "string"
				}
			}
		},
		"AuditSummary": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"concepts",
				"valid",
				"edges",
				"orphans",
				"broken_links",
				"missing_keywords",
				"missing_index_targets",
