{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://weave.dev/contract/v1/defs.schema.json",
	"title": "WeaveContractV1",
	"description": "Authoritative document, graph, search and CLI envelope definitions for Weave contract v1.",
	"type": "object",
	"additionalProperties": false,
	"$defs": {
		"OkfVersion": {
			"type": "string",
			"enum": ["0.2"]
		},
		"ConceptStatus": {
			"type": "string",
			"enum": ["draft", "stable", "deprecated"]
		},
		"SearchMode": {
			"type": "string",
			"enum": ["keyword", "fuzzy", "hybrid"]
		},
		"SearchField": {
			"type": "string",
			"enum": ["title", "description", "body"]
		},
		"AuditFailOn": {
			"type": "string",
			"enum": ["error", "warning", "none"]
		},
		"AuditSeverity": {
			"type": "string",
			"enum": ["error", "warning", "info"]
		},
		"AuditFindingCode": {
			"type": "string",
			"enum": [
				"MISSING_FRONTMATTER",
				"MISSING_TYPE",
				"MISSING_KEYWORDS",
				"BROKEN_LINK",
				"BROKEN_RELATED",
				"MISSING_INDEX_TARGET",
				"UNINDEXED_CONCEPT",
				"ORPHAN_CONCEPT",
				"UNSUPPORTED_OKF_VERSION",
				"EMPTY_BUNDLE",
				"DANGLING_EXTERNAL",
				"KEY_UNAVAILABLE"
			]
		},
		"RelateDirection": {
			"type": "string",
			"enum": ["out", "in", "both"]
		},
		"ErrorCode": {
			"type": "string",
			"enum": [
				"INVALID_REQUEST",
				"INVALID_ROOT",
				"PERMISSION_DENIED",
				"PARSE_ERROR",
				"CONCEPT_NOT_FOUND",
				"PATH_NOT_FOUND",
				"INTERNAL"
			]
		},
		"OperationName": {
			"type": "string",
			"enum": [
				"contract",
				"parse",
				"graph",
				"search",
				"list",
				"show",
				"backlinks",
				"path",
				"version",
				"audit",
				"relate"
			]
		},
		"OkfLink": {
			"type": "object",
			"additionalProperties": false,
			"required": ["raw", "target", "resolves_in_bundle"],
			"properties": {
				"raw": { "type": "string" },
				"target": { "type": "string" },
				"resolved": { "type": "string" },
				"resolves_in_bundle": { "type": "boolean" }
			}
		},
		"OkfConcept": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "path", "frontmatter", "type", "keywords", "body", "links"],
			"properties": {
				"id": { "type": "string" },
				"path": { "type": "string" },
				"frontmatter": {
					"type": "object",
					"additionalProperties": true
				},
				"type": { "type": "string" },
				"keywords": {
					"type": "array",
					"items": { "type": "string", "minLength": 1 }
				},
				"title": { "type": "string" },
				"description": { "type": "string" },
				"tags": {
					"type": "array",
					"items": { "type": "string" }
				},
				"status": { "$ref": "#/$defs/ConceptStatus" },
				"body": { "type": "string" },
				"links": {
					"type": "array",
					"items": { "$ref": "#/$defs/OkfLink" }
				}
			}
		},
		"IndexEntry": {
			"type": "object",
			"additionalProperties": false,
			"required": ["title", "target"],
			"properties": {
				"title": { "type": "string" },
				"target": { "type": "string" },
				"description": { "type": "string" }
			}
		},
		"ConceptValidation": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "has_frontmatter", "has_type", "has_keywords", "warnings"],
			"properties": {
				"id": { "type": "string" },
				"has_frontmatter": { "type": "boolean" },
				"has_type": { "type": "boolean" },
				"has_keywords": { "type": "boolean" },
				"warnings": {
					"type": "array",
					"items": { "type": "string" }
				}
			}
		},
		"Validation": {
			"type": "object",
			"additionalProperties": false,
			"required": ["valid", "concepts", "warnings"],
			"properties": {
				"valid": { "type": "boolean" },
				"concepts": {
					"type": "array",
					"items": { "$ref": "#/$defs/ConceptValidation" }
				},
				"warnings": {
					"type": "array",
					"items": { "type": "string" }
				}
			}
		},
		"Bundle": {
			"type": "object",
			"additionalProperties": false,
			"required": ["root", "concepts", "validation"],
			"properties": {
				"root": { "type": "string" },
				"okf_version": { "$ref": "#/$defs/OkfVersion" },
				"concepts": {
					"type": "array",
					"items": { "$ref": "#/$defs/OkfConcept" }
				},
				"index": {
					"type": "array",
					"items": { "$ref": "#/$defs/IndexEntry" }
				},
				"validation": { "$ref": "#/$defs/Validation" }
			}
		},
		"GraphNode": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "path", "type", "title", "keywords", "in_degree", "out_degree"],
			"properties": {
				"id": { "type": "string" },
				"path": { "type": "string" },
				"type": { "type": "string" },
				"title": { "type": "string" },
				"keywords": {
					"type": "array",
					"items": { "type": "string" }
				},
				"status": { "$ref": "#/$defs/ConceptStatus" },
				"tags": {
					"type": "array",
					"items": { "type": "string" }
				},
				"in_degree": { "type": "integer", "minimum": 0 },
				"out_degree": { "type": "integer", "minimum": 0 }
			}
		},
		"GraphEdge": {
			"type": "object",
			"additionalProperties": false,
			"required": ["from", "to", "source"],
			"properties": {
				"from": { "type": "string" },
				"to": { "type": "string" },
				"source": { "type": "string", "enum": ["link", "related"] },
				"raw": { "type": "string" }
			}
		},
		"Graph": {
			"type": "object",
			"additionalProperties": false,
			"required": ["nodes", "edges", "dangling"],
			"properties": {
				"nodes": {
					"type": "array",
					"items": { "$ref": "#/$defs/GraphNode" }
				},
				"edges": {
					"type": "array",
					"items": { "$ref": "#/$defs/GraphEdge" }
				},
				"dangling": {
					"type": "object",
					"additionalProperties": {
						"type": "array",
						"items": { "$ref": "#/$defs/OkfLink" }
					}
				}
			}
		},
		"KeywordHit": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "title", "path", "type", "keywords", "matched_keywords", "score"],
			"properties": {
				"id": { "type": "string" },
				"title": { "type": "string" },
				"path": { "type": "string" },
				"type": { "type": "string" },
				"keywords": {
					"type": "array",
					"items": { "type": "string" }
				},
				"matched_keywords": {
					"type": "array",
					"items": { "type": "string" }
				},
				"score": { "type": "number", "minimum": 0, "maximum": 1 }
			}
		},
		"FuzzyHit": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "title", "path", "type", "score", "matched_fields"],
			"properties": {
				"id": { "type": "string" },
				"title": { "type": "string" },
				"path": { "type": "string" },
				"type": { "type": "string" },
				"score": { "type": "number", "minimum": 0, "maximum": 1 },
				"matched_fields": {
					"type": "array",
					"items": { "$ref": "#/$defs/SearchField" }
				},
				"snippet": { "type": "string" }
			}
		},
		"HybridHit": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"title",
				"path",
				"type",
				"keyword_score",
				"fuzzy_score",
				"total_score",
				"matched_keywords",
				"matched_fields"
			],
			"properties": {
				"id": { "type": "string" },
				"title": { "type": "string" },
				"path": { "type": "string" },
				"type": { "type": "string" },
				"keyword_score": { "type": "number", "minimum": 0, "maximum": 1 },
				"fuzzy_score": { "type": "number", "minimum": 0, "maximum": 1 },
				"total_score": { "type": "number", "minimum": 0, "maximum": 1 },
				"matched_keywords": {
					"type": "array",
					"items": { "type": "string" }
				},
				"matched_fields": {
					"type": "array",
					"items": { "$ref": "#/$defs/SearchField" }
				},
				"snippet": { "type": "string" }
			}
		},
		"SearchResponse": {
			"type": "object",
			"additionalProperties": false,
			"required": ["query", "mode", "top_k", "keyword", "fuzzy", "hybrid"],
			"properties": {
				"query": { "type": "string" },
				"mode": { "$ref": "#/$defs/SearchMode" },
				"top_k": { "type": "integer", "minimum": 1, "maximum": 100 },
				"keyword": {
					"type": "array",
					"items": { "$ref": "#/$defs/KeywordHit" }
				},
				"fuzzy": {
					"type": "array",
					"items": { "$ref": "#/$defs/FuzzyHit" }
				},
				"hybrid": {
					"type": "array",
					"items": { "$ref": "#/$defs/HybridHit" }
				}
			}
		},
		"ListResult": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "title", "path", "type", "keywords"],
			"properties": {
				"id": { "type": "string" },
				"title": { "type": "string" },
				"path": { "type": "string" },
				"type": { "type": "string" },
				"keywords": {
					"type": "array",
					"items": { "type": "string" }
				},
				"status": { "$ref": "#/$defs/ConceptStatus" },
				"tags": {
					"type": "array",
					"items": { "type": "string" }
				}
			}
		},
		"ListResults": {
			"type": "array",
			"items": { "$ref": "#/$defs/ListResult" }
		},
		"ShowLink": {
			"type": "object",
			"additionalProperties": false,
			"required": ["raw", "target", "resolves_in_bundle"],
			"properties": {
				"raw": { "type": "string" },
				"target": { "type": "string" },
				"resolves_in_bundle": { "type": "boolean" }
			}
		},
		"ShowResult": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "path", "type", "keywords", "body", "links", "backlinks"],
			"properties": {
				"id": { "type": "string" },
				"path": { "type": "string" },
				"type": { "type": "string" },
				"keywords": {
					"type": "array",
					"items": { "type": "string" }
				},
				"title": { "type": "string" },
				"description": { "type": "string" },
				"tags": {
					"type": "array",
					"items": { "type": "string" }
				},
				"status": { "$ref": "#/$defs/ConceptStatus" },
				"body": { "type": "string" },
				"links": {
					"type": "array",
					"items": { "$ref": "#/$defs/ShowLink" }
				},
				"backlinks": {
					"type": "array",
					"items": { "type": "string" }
				}
			}
		},
		"Backlink": {
			"type": "object",
			"additionalProperties": false,
			"required": ["from", "title"],
			"properties": {
				"from": { "type": "string" },
				"title": { "type": "string" }
			}
		},
		"BacklinksResult": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "backlinks"],
			"properties": {
				"id": { "type": "string" },
				"backlinks": {
					"type": "array",
					"items": { "$ref": "#/$defs/Backlink" }
				}
			}
		},
		"PathResult": {
			"type": "object",
			"additionalProperties": false,
			"required": ["from", "to", "path"],
			"properties": {
				"from": { "type": "string" },
				"to": { "type": "string" },
				"path": {
					"type": ["array", "null"],
					"items": { "type": "string" }
				}
			}
		},
		"AuditFinding": {
			"type": "object",
			"additionalProperties": false,
			"required": ["code", "severity", "message"],
			"properties": {
				"code": { "$ref": "#/$defs/AuditFindingCode" },
				"severity": { "$ref": "#/$defs/AuditSeverity" },
				"concept": { "type": "string" },
				"source": { "type": "string" },
				"target": { "type": "string" },
				"message": { "type": "string" }
			}
		},
		"AuditSummary": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"concepts",
				"valid",
				"edges",
				"orphans",
				"broken_links",
				"missing_keywords",
				"missing_index_targets",
				"unindexed_concepts"
			],
			"properties": {
				"concepts": { "type": "integer", "minimum": 0 },
				"valid": { "type": "boolean" },
				"edges": { "type": "integer", "minimum": 0 },
				"orphans": { "type": "integer", "minimum": 0 },
				"broken_links": { "type": "integer", "minimum": 0 },
				"missing_keywords": { "type": "integer", "minimum": 0 },
				"missing_index_targets": { "type": "integer", "minimum": 0 },
				"unindexed_concepts": { "type": "integer", "minimum": 0 }
			}
		},
		"AuditReport": {
			"type": "object",
			"additionalProperties": false,
			"required": ["path", "ok", "fail_on", "summary", "findings"],
			"properties": {
				"path": { "type": "string" },
				"ok": { "type": "boolean" },
				"fail_on": { "$ref": "#/$defs/AuditFailOn" },
				"summary": { "$ref": "#/$defs/AuditSummary" },
				"findings": {
					"type": "array",
					"items": { "$ref": "#/$defs/AuditFinding" }
				}
			}
		},
		"RelateEdge": {
			"type": "object",
			"additionalProperties": false,
			"required": ["from", "to", "source", "depth"],
			"properties": {
				"from": { "type": "string" },
				"to": { "type": "string" },
				"source": { "type": "string", "enum": ["link", "related"] },
				"raw": { "type": "string" },
				"depth": { "type": "integer", "minimum": 0, "maximum": 5 }
			}
		},
		"RelateResult": {
			"type": "object",
			"additionalProperties": false,
			"required": ["root", "direction", "depth", "nodes", "edges"],
			"properties": {
				"root": { "type": "string" },
				"direction": { "$ref": "#/$defs/RelateDirection" },
				"depth": { "type": "integer", "minimum": 0, "maximum": 5 },
				"nodes": {
					"type": "array",
					"items": { "$ref": "#/$defs/GraphNode" }
				},
				"edges": {
					"type": "array",
					"items": { "$ref": "#/$defs/RelateEdge" }
				}
			}
		},
		"OperationDescriptor": {
			"type": "object",
			"additionalProperties": false,
			"required": ["op", "fields", "result"],
			"properties": {
				"op": { "$ref": "#/$defs/OperationName" },
				"fields": {
					"type": "array",
					"items": { "type": "string" }
				},
				"result": { "type": "string" }
			}
		},
		"ContractInfo": {
			"type": "object",
			"additionalProperties": false,
			"required": ["contract", "cli", "binary_version", "operations", "errors"],
			"properties": {
				"contract": { "type": "string", "const": "weave.contract/v1" },
				"cli": { "type": "string", "const": "weave.cli/v1" },
				"binary_version": { "type": "string" },
				"operations": {
					"type": "array",
					"items": { "$ref": "#/$defs/OperationDescriptor" }
				},
				"errors": {
					"type": "array",
					"items": { "$ref": "#/$defs/ErrorCode" }
				}
			}
		},
		"VersionInfo": {
			"type": "object",
			"additionalProperties": false,
			"required": ["binary_version", "contract", "cli"],
			"properties": {
				"binary_version": { "type": "string" },
				"contract": { "type": "string", "const": "weave.contract/v1" },
				"cli": { "type": "string", "const": "weave.cli/v1" }
			}
		},
		"OperationRequest": {
			"type": "object",
			"additionalProperties": false,
			"required": ["op"],
			"properties": {
				"id": { "type": "string" },
				"op": { "$ref": "#/$defs/OperationName" },
				"path": { "type": "string" },
				"query": { "type": "string" },
				"mode": { "$ref": "#/$defs/SearchMode" },
				"top_k": { "type": "integer", "minimum": 1, "maximum": 100 },
				"target": { "type": "string" },
				"from": { "type": "string" },
				"to": { "type": "string" },
				"types": {
					"type": "array",
					"items": { "type": "string" }
				},
				"tags": {
					"type": "array",
					"items": { "type": "string" }
				},
				"status": { "type": "string" },
				"limit": { "type": "integer", "minimum": 0 },
				"fail_on": { "$ref": "#/$defs/AuditFailOn" },
				"verify_keys": { "type": "boolean" },
				"depth": { "type": "integer", "minimum": 0, "maximum": 5 },
				"direction": { "$ref": "#/$defs/RelateDirection" }
			}
		},
		"OperationError": {
			"type": "object",
			"additionalProperties": false,
			"required": ["code", "message"],
			"properties": {
				"code": { "$ref": "#/$defs/ErrorCode" },
				"message": { "type": "string" },
				"details": {
					"type": "object",
					"additionalProperties": true
				}
			}
		},
		"SuccessEnvelope": {
			"type": "object",
			"additionalProperties": false,
			"required": ["contract", "cli", "ok", "result"],
			"properties": {
				"id": { "type": "string" },
				"contract": { "type": "string", "const": "weave.contract/v1" },
				"cli": { "type": "string", "const": "weave.cli/v1" },
				"ok": { "type": "boolean", "const": true },
				"result": {}
			}
		},
		"FailureEnvelope": {
			"type": "object",
			"additionalProperties": false,
			"required": ["contract", "cli", "ok", "error"],
			"properties": {
				"id": { "type": "string" },
				"contract": { "type": "string", "const": "weave.contract/v1" },
				"cli": { "type": "string", "const": "weave.cli/v1" },
				"ok": { "type": "boolean", "const": false },
				"error": { "$ref": "#/$defs/OperationError" }
			}
		},
		"Envelope": {
			"oneOf": [
				{ "$ref": "#/$defs/SuccessEnvelope" },
				{ "$ref": "#/$defs/FailureEnvelope" }
			]
		}
	}
}
