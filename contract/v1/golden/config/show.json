{
	"config_path": "<config>",
	"exists": true,
	"entries": [
		{
			"key": "db",
			"value": "/srv/weave/index.db",
			"source": "file",
			"origin": "file <config>"
		},
		{
			"key": "no_db",
			"value": false,
