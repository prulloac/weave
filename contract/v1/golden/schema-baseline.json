{
	"version": 1,
	"defs": {
		"AuditFailOn": {
			"type": "string",
			"enum": [
				"error",
				"none",
				"warning"
			]
		},
		"AuditFinding": {
			"type": "object",
			"required": [
				"code",
				"message",
				"severity"
			],
			"additional_properties": false,
			"properties": {
				"code": {
					"ref": "#/$defs/AuditFindingCode"
				},
				"concept": {
					"type": "string"
				},
				"message": {
					"type": "string"
				},
				"severity": {
					"ref": "#/$defs/AuditSeverity"
				},
				"source": {
					"type": "string"
				},
				"target": {
					"type": "string"
				}
			}
		},
		"AuditFindingCode": {
			"type": "string",
			"enum": [
				"BROKEN_LINK",
				"BROKEN_RELATED",
				"DANGLING_EXTERNAL",
				"EMPTY_BUNDLE",
				"KEY_UNAVAILABLE",
				"MISSING_FRONTMATTER",
				"MISSING_INDEX_TARGET",
				"MISSING_KEYWORDS",
				"MISSING_TYPE",
				"ORPHAN_CONCEPT",
				"UNINDEXED_CONCEPT",
				"UNSUPPORTED_OKF_VERSION"
			]
		},
		"AuditReport": {
			"type": "object",
			"required": [
				"fail_on",
				"findings",
				"ok",
				"path",
				"summary"
			],
			"additional_properties": false,
			"properties": {
				"fail_on": {
					"ref": "#/$defs/AuditFailOn"
				},
				"findings": {
					"type": "array",
					"items": {
						"ref": "#/$defs/AuditFinding"
					}
				},
				"ok": {
					"type": "boolean"
				},
				"path": {
					"type": "string"
				},
				"summary": {
					"ref": "#/$defs/AuditSummary"
				}
			}
		},
		"AuditSeverity": {
			"type": "string",
			"enum": [
				"error",
				"info",
				"warning"
			]
		},
		"AuditSummary": {
			"type": "object",
			"required": [
				"broken_links",
				"concepts",
				"edges",
				"missing_index_targets",
				"missing_keywords",
				"orphans",
				"unindexed_concepts",
				"valid"
			],
			"additional_properties": false,
			"properties": {
				"broken_links": {
					"type": "integer",
					"minimum": 0
				},
				"concepts": {
					"type": "integer",
					"minimum": 0
				},
				"edges": {
					"type": "integer",
					"minimum": 0
				},
				"missing_index_targets": {
					"type": "integer",
					"minimum": 0
				},
				"missing_keywords": {
					"type": "integer",
					"minimum": 0
				},
				"orphans": {
					"type": "integer",
					"minimum": 0
				},
				"unindexed_concepts": {
					"type": "integer",
					"minimum": 0
				},
				"valid": {
					"type": "boolean"
				}
			}
		},
		"Backlink": {
			"type": "object",
			"required": [
				"from",
				"title"
			],
			"additional_properties": false,
			"properties": {
				"from": {
					"type": "string"
				},
				"title": {
					"type": "string"
				}
			}
		},
		"BacklinksResult": {
			"type": "object",
			"required": [
				"backlinks",
				"id"
			],
			"additional_properties": false,
			"properties": {
				"backlinks": {
					"type": "array",
					"items": {
						"ref": "#/$defs/Backlink"
					}
				},
				"id": {
					"type": "string"
				}
			}
		},
		"Bundle": {
			"type": "object",
			"required": [
				"concepts",
				"root",
				"validation"
			],
			"additional_properties": false,
			"properties": {
				"concepts": {
					"type": "array",
					"items": {
						"ref": "#/$defs/OkfConcept"
					}
				},
				"index": {
					"type": "array",
					"items": {
						"ref": "#/$defs/IndexEntry"
					}
				},
				"okf_version": {
					"ref": "#/$defs/OkfVersion"
				},
				"root": {
					"type": "string"
				},
				"validation": {
					"ref": "#/$defs/Validation"
				}
			}
		},
		"ConceptStatus": {
			"type": "string",
			"enum": [
				"deprecated",
				"draft",
				"stable"
			]
		},
		"ConceptValidation": {
			"type": "object",
			"required": [
				"has_frontmatter",
				"has_keywords",
				"has_type",
				"id",
				"warnings"
			],
			"additional_properties": false,
			"properties": {
				"has_frontmatter": {
					"type": "boolean"
				},
				"has_keywords": {
					"type": "boolean"
				},
				"has_type": {
					"type": "boolean"
				},
				"id": {
					"type": "string"
				},
				"warnings": {
					"type": "array",
					"items": {
						"type": "string"
					}
				}
			}
		},
		"ConfigEntry": {
			"type": "object",
			"required": [
				"key",
				"source",
				"value"
			],
			"additional_properties": false,
			"properties": {
				"key": {
					"type": "string"
				},
				"origin": {
					"type": "string"
				},
				"source": {
					"ref": "#/$defs/ConfigSource"
				},
				"value": {
					"ref": "#/$defs/ConfigValue"
				}
			}
		},
		"ConfigGet": {
			"type": "object",
			"required": [
				"key",
				"source",
				"value"
			],
			"additional_properties": false,
			"properties": {
				"key": {
					"type": "string"
				},
				"origin": {
					"type": "string"
				},
				"source": {
					"ref": "#/$defs/ConfigSource"
				},
				"value": {
					"ref": "#/$defs/ConfigValue"
				}
			}
		},
		"ConfigInit": {
			"type": "object",
			"required": [
				"created",
				"path"
			],
			"additional_properties": false,
			"properties": {
				"created": {
					"type": "boolean"
				},
				"next_command": {
					"type": "string"
				},
				"path": {
					"type": "string"
				}
			}
		},
		"ConfigPath": {
			"type": "object",
			"required": [
				"exists",
				"path"
			],
			"additional_properties": false,
			"properties": {
				"exists": {
					"type": "boolean"
				},
				"path": {
					"type": "string"
				}
			}
		},
		"ConfigShow": {
			"type": "object",
			"required": [
				"config_path",
				"entries",
				"exists"
			],
			"additional_properties": false,
			"properties": {
				"config_path": {
					"type": "string"
				},
				"entries": {
					"type": "array",
					"items": {
						"ref": "#/$defs/ConfigEntry"
					}
				},
				"exists": {
					"type": "boolean"
				}
			}
		},
		"ConfigSource": {
			"type": "string",
			"enum": [
				"default",
				"env",
				"file",
				"flag"
			]
		},
		"ConfigValue": {
			"variants": [
				{
					"type": "string"
				},
				{
					"type": "boolean"
				},
				{
					"type": "integer"
				}
			]
		},
		"ContractInfo": {
			"type": "object",
			"required": [
				"binary_version",
				"cli",
				"contract",
				"errors",
				"operations"
			],
			"additional_properties": false,
			"properties": {
				"binary_version": {
					"type": "string"
				},
				"cli": {
					"type": "string",
					"const": "weave.cli/v1"
				},
				"contract": {
					"type": "string",
					"const": "weave.contract/v1"
				},
				"errors": {
					"type": "array",
					"items": {
						"ref": "#/$defs/ErrorCode"
					}
				},
				"operations": {
					"type": "array",
					"items": {
						"ref": "#/$defs/OperationDescriptor"
					}
				}
			}
		},
		"Envelope": {
			"variants": [
				{
					"ref": "#/$defs/SuccessEnvelope"
				},
				{
					"ref": "#/$defs/FailureEnvelope"
				}
			]
		},
		"ErrorCode": {
			"type": "string",
			"enum": [
				"BUNDLE_NOT_INDEXED",
				"CONCEPT_NOT_FOUND",
				"CONFIRMATION_REQUIRED",
				"EXTENSION_FAILED",
				"EXTENSION_NOT_FOUND",
				"EXTENSION_PROTOCOL",
				"EXTENSION_TIMEOUT",
				"INTERNAL",
				"INVALID_REQUEST",
				"INVALID_ROOT",
				"PARSE_ERROR",
				"PATH_NOT_FOUND",
				"PERMISSION_DENIED",
				"PRIVACY_DECRYPT_FAILED",
				"PRIVACY_DIRECTIVE_INVALID",
				"PRIVACY_KEY_UNAVAILABLE",
				"PRIVACY_PROVIDER_UNSUPPORTED"
			]
		},
		"ExplainFuzzy": {
			"type": "object",
			"required": [
				"fields",
				"matched_fields",
				"score",
				"tokens"
			],
			"additional_properties": false,
			"properties": {
				"fields": {
					"type": "array",
					"items": {
						"ref": "#/$defs/ExplainFuzzyField"
					}
				},
				"matched_fields": {
					"type": "array",
					"items": {
						"ref": "#/$defs/SearchField"
					}
				},
				"score": {
					"type": "number",
					"minimum": 0,
					"maximum": 1
				},
				"snippet": {
					"type": "string"
				},
				"tokens": {
					"type": "array",
					"items": {
						"ref": "#/$defs/ExplainFuzzyToken"
					}
				}
			}
		},
		"ExplainFuzzyField": {
			"type": "object",
			"required": [
				"contribution",
				"field",
				"score",
				"weight"
			],
			"additional_properties": false,
			"properties": {
				"contribution": {
					"type": "number",
					"minimum": 0,
					"maximum": 1
				},
				"field": {
					"ref": "#/$defs/SearchField"
				},
				"score": {
					"type": "number",
					"minimum": 0,
					"maximum": 1
				},
				"weight": {
					"type": "number",
					"minimum": 0,
					"maximum": 1
				}
			}
		},
		"ExplainFuzzyToken": {
			"type": "object",
			"required": [
				"field",
				"matched_token",
				"query_token",
				"similarity"
			],
			"additional_properties": false,
			"properties": {
				"field": {
					"ref": "#/$defs/SearchField"
				},
				"matched_token": {
					"type": "string"
				},
				"query_token": {
					"type": "string"
				},
				"similarity": {
					"type": "number",
					"minimum": 0,
					"maximum": 1
				}
			}
		},
		"ExplainHybrid": {
			"type": "object",
			"required": [
				"fuzzy_weight",
				"keyword_weight",
				"total"
			],
			"additional_properties": false,
			"properties": {
				"fuzzy_weight": {
					"type": "number",
					"minimum": 0,
					"maximum": 1
				},
				"keyword_weight": {
					"type": "number",
					"minimum": 0,
					"maximum": 1
				},
				"lexical_weight": {
					"type": "number",
					"minimum": 0,
					"maximum": 1
				},
				"total": {
					"type": "number",
					"minimum": 0,
					"maximum": 1
				}
			}
		},
		"ExplainKeyword": {
			"type": "object",
			"required": [
				"matched_keywords",
				"score",
				"tokens"
			],
			"additional_properties": false,
			"properties": {
				"matched_keywords": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"score": {
					"type": "number",
					"minimum": 0,
					"maximum": 1
				},
				"tokens": {
					"type": "array",
					"items": {
						"ref": "#/$defs/ExplainKeywordToken"
					}
				}
			}
		},
		"ExplainKeywordMatch": {
			"type": "string",
			"enum": [
				"exact",
				"none",
				"prefix"
			]
		},
		"ExplainKeywordToken": {
			"type": "object",
			"required": [
				"match",
				"matched_keyword",
				"query_token",
				"score"
			],
			"additional_properties": false,
			"properties": {
				"match": {
					"ref": "#/$defs/ExplainKeywordMatch"
				},
				"matched_keyword": {
					"type": "string"
				},
				"query_token": {
					"type": "string"
				},
				"score": {
					"type": "number",
					"minimum": 0,
					"maximum": 1
				}
			}
		},
		"ExplainLexical": {
			"type": "object",
			"required": [
				"matched_fields",
				"raw_score",
				"score",
				"tokens"
			],
			"additional_properties": false,
			"properties": {
				"matched_fields": {
					"type": "array",
					"items": {
						"ref": "#/$defs/SearchField"
					}
				},
				"raw_score": {
					"type": "number",
					"minimum": 0
				},
				"score": {
					"type": "number",
					"minimum": 0,
					"maximum": 1
				},
				"tokens": {
					"type": "array",
					"items": {
						"ref": "#/$defs/ExplainLexicalToken"
					}
				}
			}
		},
		"ExplainLexicalToken": {
			"type": "object",
			"required": [
				"contribution",
				"matched",
				"query_token"
			],
			"additional_properties": false,
			"properties": {
				"contribution": {
					"type": "number",
					"minimum": 0
				},
				"matched": {
					"type": "boolean"
				},
				"query_token": {
					"type": "string"
				}
			}
		},
		"ExplainResult": {
			"type": "object",
			"required": [
				"found",
				"fuzzy",
				"hybrid",
				"id",
				"keyword",
				"mode",
				"query",
				"rank",
				"top_k"
			],
			"additional_properties": false,
			"properties": {
				"found": {
					"type": "boolean"
				},
				"fuzzy": {
					"ref": "#/$defs/ExplainFuzzy"
				},
				"hybrid": {
					"ref": "#/$defs/ExplainHybrid"
				},
				"id": {
					"type": "string"
				},
				"keyword": {
					"ref": "#/$defs/ExplainKeyword"
				},
				"lexical": {
					"ref": "#/$defs/ExplainLexical"
				},
				"mode": {
					"ref": "#/$defs/SearchMode"
				},
				"query": {
					"type": "string"
				},
				"rank": {
					"type": "integer",
					"minimum": 0
				},
				"source": {
					"type": "string"
				},
				"top_k": {
					"type": "integer",
					"minimum": 1,
					"maximum": 100
				}
			}
		},
		"ExportReport": {
			"type": "object",
			"required": [
				"documents",
				"encrypted",
				"format",
				"hashed",
				"out",
				"source",
				"tokenized"
			],
			"additional_properties": false,
			"properties": {
				"confirmation_required": {
					"type": "boolean"
				},
				"documents": {
					"type": "integer"
				},
				"dry_run": {
					"type": "boolean"
				},
				"encrypted": {
					"type": "integer"
				},
				"format": {
					"type": "string",
					"enum": [
						"encrypted",
						"raw"
					]
				},
				"hashed": {
					"type": "integer"
				},
				"out": {
					"type": "string"
				},
				"source": {
					"type": "string"
				},
				"tokenized": {
					"type": "integer"
				}
			}
		},
		"ExtensionInfo": {
			"type": "object",
			"required": [
				"name",
				"path",
				"source"
			],
			"additional_properties": false,
			"properties": {
				"name": {
					"type": "string"
				},
				"path": {
					"type": "string"
				},
				"source": {
					"type": "string",
					"enum": [
						"bundle",
						"path"
					]
				}
			}
		},
		"ExtensionList": {
			"type": "object",
			"required": [
				"extensions"
			],
			"additional_properties": false,
			"properties": {
				"extensions": {
					"type": "array",
					"items": {
						"ref": "#/$defs/ExtensionInfo"
					}
				}
			}
		},
		"FailureEnvelope": {
			"type": "object",
			"required": [
				"cli",
				"contract",
				"error",
				"ok"
			],
			"additional_properties": false,
			"properties": {
				"cli": {
					"type": "string",
					"const": "weave.cli/v1"
				},
				"contract": {
					"type": "string",
					"const": "weave.contract/v1"
				},
				"error": {
					"ref": "#/$defs/OperationError"
				},
				"id": {
					"type": "string"
				},
				"ok": {
					"type": "boolean",
					"const": false
				}
			}
		},
		"FuzzyHit": {
			"type": "object",
			"required": [
				"id",
				"matched_fields",
				"path",
				"score",
				"title",
				"type"
			],
			"additional_properties": false,
			"properties": {
				"id": {
					"type": "string"
				},
				"matched_fields": {
					"type": "array",
					"items": {
						"ref": "#/$defs/SearchField"
					}
				},
				"path": {
					"type": "string"
				},
				"rerank_score": {
					"type": "number",
					"minimum": 0,
					"maximum": 1
				},
				"score": {
					"type": "number",
					"minimum": 0,
					"maximum": 1
				},
				"snippet": {
					"type": "string"
				},
				"source": {
					"type": "string"
				},
				"title": {
					"type": "string"
				},
				"type": {
					"type": "string"
				}
			}
		},
		"Graph": {
			"type": "object",
			"required": [
				"dangling",
				"edges",
				"nodes"
			],
			"additional_properties": false,
			"properties": {
				"dangling": {
					"type": "object"
				},
				"edges": {
					"type": "array",
					"items": {
						"ref": "#/$defs/GraphEdge"
					}
				},
				"nodes": {
					"type": "array",
					"items": {
						"ref": "#/$defs/GraphNode"
					}
				}
			}
		},
		"GraphEdge": {
			"type": "object",
			"required": [
				"from",
				"source",
				"to"
			],
			"additional_properties": false,
			"properties": {
				"from": {
					"type": "string"
				},
				"raw": {
					"type": "string"
				},
				"source": {
					"type": "string",
					"enum": [
						"link",
						"related"
					]
				},
				"to": {
					"type": "string"
				}
			}
		},
		"GraphNode": {
			"type": "object",
			"required": [
				"id",
				"in_degree",
				"keywords",
				"out_degree",
				"path",
				"title",
				"type"
			],
			"additional_properties": false,
			"properties": {
				"id": {
					"type": "string"
				},
				"in_degree": {
					"type": "integer",
					"minimum": 0
				},
				"keywords": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"out_degree": {
					"type": "integer",
					"minimum": 0
				},
				"path": {
					"type": "string"
				},
				"source": {
					"type": "string"
				},
				"status": {
					"ref": "#/$defs/ConceptStatus"
				},
				"tags": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"title": {
					"type": "string"
